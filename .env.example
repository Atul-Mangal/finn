# Required for classification, extraction and analysis (free key: aistudio.google.com)
GEMINI_API_KEY=
# Optional: executive bios on management-change alerts (tavily.com)
TAVILY_API_KEY=
# Optional: model overrides
# CHEAP_MODEL=gemini-2.5-flash-lite
# STRONG_MODEL=gemini-2.5-flash
# Optional: any OpenAI-compatible provider instead of Gemini (Groq, OpenRouter, Ollama)
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# Optional: persistent cache for live research on Vercel (upstash.com, free tier)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
